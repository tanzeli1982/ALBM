#!/bin/bash -l

#SBATCH -J albm_fcast2
#SBATCH -N 1 
#SBATCH -n 1
#SBATCH -t 03:00:00
#SBATCH -A  rsvtmp 
##SBATCH  --exclusive
##SBATCH -p slurm
#SBATCH -p short
#SBATCH --mail-type=END
#SBATCH --mail-user=zeli.tan@pnnl.gov
#SBATCH -o slurm.out
#SBATCH -e slurm.out

set -eo pipefail

cd "${SLURM_SUBMIT_DIR:-$PWD}"

module purge

export NETCDF_HOME=/people/tanz151/packages/Pnetcdf_mvapich_2.3.7
export LD_LIBRARY_PATH=$NETCDF_HOME/lib:${LD_LIBRARY_PATH:-}
module load intel/2022.1.0 mvapich2/2.3.7

export MV2_USE_SHMEM_COLL=0

# Monthly forecasts: June 1-July 1, July 1-August 1, August 1-September 1.
# Namelist editing uses GNU grep/sed
namelist=namelist.bLake.fcast2
years=(2001 2002 2004 2005 2006 2008 2009 2010 2011 2013 2014 2015 2016 2017)
months=(6 7 8)

[[ -x ./ALBM.exe && -f "$namelist" ]] || {
    echo "ERROR: ALBM.exe or $namelist is missing/unusable." >&2
    exit 1
}

# Validate assignments and filename formats before editing.
for key in Start_Year Start_Month End_Year End_Month opt_file restart_file tas_file hurs_file ps_file pr_file rsds_file rlds_file wind_file; do
    case "$key" in
        Start_Year|Start_Month|End_Year|End_Month) value_pattern='[+-]?[0-9]+' ;;
        opt_file) value_pattern="'[^']*'" ;;
        restart_file) value_pattern="'[^']*bLake[.]r[.][0-9]{6}01[.]nc'" ;;
        *) value_pattern="'[^']*_[0-9]{6}01-[0-9]{6}02[.]nc'" ;;
    esac
    count=$(grep -Eic "^[[:blank:]]*${key}[[:blank:]]*=[[:blank:]]*${value_pattern}" "$namelist" || true)
    if [[ "$count" -ne 1 ]]; then
        echo "ERROR: Expected exactly one valid $key assignment; found $count." >&2
        exit 1
    fi
done
for key in Start_Day End_Day; do
    grep -Eiq "^[[:blank:]]*${key}[[:blank:]]*=[[:blank:]]*1([[:space:],!]|$)" "$namelist" || {
        echo "ERROR: $key must equal 1 for monthly forecasts." >&2
        exit 1
    }
done

mkdir -p Forecast
backup=$(mktemp "${namelist}.backup.XXXXXX")
cp -p -- "$namelist" "$backup"
trap 'cp -p -- "$backup" "$namelist"; rm -f -- "$backup"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

for year in "${years[@]}"; do
    for month in "${months[@]}"; do
        case "$month" in
            6) opt_filename=optpar_jun_fcast.dat ;;
            7) opt_filename=optpar_jul_fcast.dat ;;
            8) opt_filename=optpar_aug_fcast.dat ;;
        esac
        end_month=$((month + 1))
        printf -v start_stamp '%04d%02d01' "$year" "$month"
        printf -v end_stamp '%04d%02d01' "$year" "$end_month"
        printf -v forcing_end_stamp '%04d%02d02' "$year" "$end_month"
        echo "[$(date -Is)] Monthly forecast: ${start_stamp} to ${end_stamp}"

        # Select the monthly parameter file in the current directory.
        # Preserve forcing/restart directories, prefixes, and unrelated settings.
        # Forcing filenames extend to day 2; simulations end on day 1.
        sed -E -i \
            -e "s|^([[:blank:]]*opt_file[[:blank:]]*=[[:blank:]]*)'[^']*'|\1'./${opt_filename}'|I" \
            -e "s/^([[:blank:]]*Start_Year[[:blank:]]*=[[:blank:]]*)[+-]?[0-9]+/\1${year}/I" \
            -e "s/^([[:blank:]]*Start_Month[[:blank:]]*=[[:blank:]]*)[+-]?[0-9]+/\1${month}/I" \
            -e "s/^([[:blank:]]*End_Year[[:blank:]]*=[[:blank:]]*)[+-]?[0-9]+/\1${year}/I" \
            -e "s/^([[:blank:]]*End_Month[[:blank:]]*=[[:blank:]]*)[+-]?[0-9]+/\1${end_month}/I" \
            -e "/^[[:blank:]]*restart_file[[:blank:]]*=/I s/(bLake[.]r[.])[0-9]{8}([.]nc)/\1${start_stamp}\2/" \
            -e "/^[[:blank:]]*(tas_file|hurs_file|ps_file|pr_file|rsds_file|rlds_file|wind_file)[[:blank:]]*=/I s/_[0-9]{8}-[0-9]{8}[.]nc/_${start_stamp}-${forcing_end_stamp}.nc/" \
            "$namelist"

        mpirun -np 1 ./ALBM.exe namelist.bLake.fcast2
        echo "[$(date -Is)] Completed monthly forecast starting ${start_stamp}"
    done
done

echo "Completed all 42 monthly forecasts."
