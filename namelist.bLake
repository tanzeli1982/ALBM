&general
 run_mode = 'regular'
 lake_file = './Lakes_GrandCoulee.nc'
 lake_range = 1, 1
 bathy_file = './Lakes_GrandCoulee_bathymetry.nc'
 opt_file = './optpar.dat'
/

&simulation
 Thermal_Module = .True.
 Bubble_Module = .False.
 Diagenesis_Module = .False.
 Carbon_Module = .False.
 Start_Year = 1979
 Start_Month = 1
 Start_Day = 1
 End_Year = 2020
 End_Month = 1
 End_Day = 1
 Spinup_Month = 7
 Spinup_Day = 1
 nSpinup = 5
 Use_Leap = .True.
/

&resolution
 NWLAYER = 50
 NSLAYER = 20
 NRLAYER = 10
 NSCOL = 5
/

&bayesian
 NMAXSAMPLE = 10000
 sample_range = 1, 10000
 mc_file = './model_parameters.dat'
 SA_Start_Year = 2016
 SA_Start_Month = 1
 SA_Start_Day = 1
 SA_End_Year = 2017
 SA_End_Month = 1
 SA_End_Day = 1
/

&radiation
 solar_dir = './Solar/'
 gas_dir = './Gases/'
 albedo_dir = './Albedo/'
 co2_file = '/rcfs/projects/rsvtmp/tanz151/input_data/cmip5_co2.nc'
 o3_file = '/rcfs/projects/rsvtmp/tanz151/input_data/o3_Amon_rcp45_r1i1p1_197801-210012.nc'
 aod_file = '/rcfs/projects/rsvtmp/tanz151/input_data/aod550_Amon_rcp45_r1i1p1_197801-210012.nc'
/

&rundata
 forcing_tstep = '1hour'
 forcing_time = 'UTC'
 tas_file = '/rcfs/projects/rsvtmp/tanz151/input_data/era5_hrly/tas_era5_hrly_GrandCoulee_19790101-20241231.nc'
 hurs_file = '/rcfs/projects/rsvtmp/tanz151/input_data/era5_hrly/hurs_era5_hrly_GrandCoulee_19790101-20241231.nc'
 ps_file = '/rcfs/projects/rsvtmp/tanz151/input_data/era5_hrly/ps_era5_hrly_GrandCoulee_19790101-20241231.nc'
 pr_file = '/rcfs/projects/rsvtmp/tanz151/input_data/era5_hrly/pr_era5_hrly_GrandCoulee_19790101-20241231.nc'
 rsds_file = '/rcfs/projects/rsvtmp/tanz151/input_data/era5_hrly/rsds_era5_hrly_GrandCoulee_19790101-20241231.nc'
 rlds_file = '/rcfs/projects/rsvtmp/tanz151/input_data/era5_hrly/rlds_era5_hrly_GrandCoulee_19790101-20241231.nc'
 wind_file = '/rcfs/projects/rsvtmp/tanz151/input_data/era5_hrly/sfcwind_era5_hrly_GrandCoulee_19790101-20241231.nc'
 hydro_file = '/rcfs/projects/rsvtmp/tanz151/input_data/Lakes_GrandCoulee_hydro_19790101-20241231.nc'
 tref_file = '/rcfs/projects/rsvtmp/tanz151/input_data/ecmwf_ref_1990s.nc'
 soc_file = '/rcfs/projects/rsvtmp/tanz151/input_data/soc_005deg.nc'
 veg_file = '/rcfs/projects/rsvtmp/tanz151/input_data/GLCFTreeCover.nc'
 wlnd_file = '/rcfs/projects/rsvtmp/tanz151/input_data/glwd.nc'
/

&archive
 archive_tstep = 'day'
 archive_dir = './'
/

&dbg
 DEBUG = .True.
/
